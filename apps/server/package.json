{
	"name": "@openagentpack/server",
	"version": "0.0.10",
	"private": true,
	"license": "Apache-2.0",
	"exports": {
		"./app": "./src/app.ts",
		"./agents-config": "./src/lib/agents-config.ts"
	},
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"start": "bun run src/index.ts",
