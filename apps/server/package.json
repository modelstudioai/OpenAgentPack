	},
	"dependencies": {
		"@hono/zod-openapi": "^1.4.0",
		"@openagentpack/project-versions": "workspace:*",
		"@openagentpack/project-workspace": "workspace:*",
		"@openagentpack/sdk": "workspace:*",
		"chokidar": "^4.0.3",
		"hono": "^4.12.28",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@openagentpack/playbooks": "workspace:*",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.3",
		"typescript": "^6.0.3"
	}
}
