{
	"name": "@openagentpack/project-versions",
	"version": "0.6.0",
	"description": "Git-independent content-addressed project versioning for OpenAgentPack",
	"license": "Apache-2.0",
	"keywords": [
		"openagentpack",
		"snapshots",
		"versioning",
		"agents.yaml"
	],
	"homepage": "https://github.com/modelstudioai/OpenAgentPack/tree/main/packages/project-versions#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/modelstudioai/OpenAgentPack.git",
		"directory": "packages/project-versions"
	},
	"bugs": {
		"url": "https://github.com/modelstudioai/OpenAgentPack/issues"
	},
	"engines": {
		"node": ">=18.17.0"
	},
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"bun": "./dist/index.js",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "tsup",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@openagentpack/sdk": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.3",
		"typescript": "^6.0.3"
	}
}
